configuration {
  modes: [ drun ];
  drun-display-format: "{name}";
}

@theme "dmenu"

* {
  font: "JetBrainsMono Nerd Font 13";
  background-color: #1e1e2e;
  text-color: #cdd6f4;
  border-color: #cba6f7;
}

window {
  width: 40%;
  y-offset: 10px;
  border: 2px;
  border-radius: 10px;
  padding: 6px;
  background-color: #1e1e2e;
}

prompt {
  enabled: false;
}

entry {
  placeholder: "Search...";
  placeholder-color: #6c7086;
  padding: 7px 10px;
  background-color: #181825;
  border-radius: 6px;
  cursor-color: #cba6f7;
}

listview {
  spacing: 4px;
}

element {
  padding: 6px 9px;
  border-radius: 6px;
  cursor: pointer;
}

element selected {
  background-color: #313244;
  text-color: #cba6f7;
}

element-text {
  background-color: inherit;
  text-color: inherit;
  cursor: inherit;
}
